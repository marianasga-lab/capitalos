// CapitalOS · Esquema de datos
// ---------------------------------------------------------------
// Proveedor: PostgreSQL (Neon en producción; cualquier Postgres en local). Todo el esquema usa tipos
// portables: Decimal para dinero, enums nativos de Prisma y
// cuid() como identificadores (sin autoincrementos dependientes
// del motor).
//
// Convención de signos:
//   - Transaction.amount SIEMPRE es positivo. La dirección la da `type`.
//   - Account.currentBalance: saldo a favor (activo).
//   - CreditCard.currentBalance: deuda vigente (pasivo, positivo = debo).
// ---------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión con pool (la que usa la app). En Vercel + Neon la crea la integración.
  url       = env("DATABASE_URL")
  // Conexión directa (migraciones).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Enums ----------

enum AccountType {
  CASH
  DEBIT
  INVESTMENT
  RECEIVABLE
}

enum Currency {
  MXN
  USD
  EUR
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REIMBURSABLE_EXPENSE
  /// Dinero de un tercero que entra a mi cuenta para un fin (no es ingreso).
  FUND_DEPOSIT
  /// Pago hecho con dinero de un tercero (no es gasto).
  FUND_PAYMENT
}

enum FundStatus {
  OPEN
  CLOSED
}

enum FundSource {
  OWN_CAPITAL
  ALLOWANCE_FAMILY
  SHARED_SPLIT
}

enum ReimbursementStatus {
  NOT_APPLICABLE
  PENDING
  PAID
}

// ---------- 1. Cuentas y activos ----------

model Account {
  id             String      @id @default(cuid())
  name           String
  type           AccountType
  currency       Currency    @default(MXN)
  currentBalance Decimal     @default(0) @db.Decimal(16, 2)
  /// Tasa anual estimada (ej. 0.105 = 10.5 %). Solo aplica a INVESTMENT.
  interestRate   Decimal?    @db.Decimal(9, 6)
  /// true = cuenta del sistema ("Cuentas por Cobrar"). No se puede borrar.
  isSystem       Boolean     @default(false)
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  outgoing       Transaction[]          @relation("TxAccount")
  incoming       Transaction[]          @relation("TxToAccount")
  reimbursedInto Transaction[]          @relation("TxReimburseAccount")
  reimbursements ReimbursementPayment[]
  savingsGoals   SavingsGoal[]

  @@index([type])
}

// ---------- 2. Tarjetas de crédito ----------

model CreditCard {
  id             String   @id @default(cuid())
  name           String
  limit          Decimal  @db.Decimal(16, 2)
  currency       Currency @default(MXN)
  /// Día de corte (1–31). Si el mes es más corto, se usa el último día.
  cutoffDay      Int
  /// Día límite de pago (1–31).
  paymentDueDay  Int
  /// CAT / tasa anual (ej. 0.65 = 65 %).
  interestRate   Decimal  @db.Decimal(9, 6)
  /// Deuda vigente. Sube con cada cargo y baja con cada pago.
  currentBalance Decimal  @default(0) @db.Decimal(16, 2)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions Transaction[]
}

// ---------- 3. Libro mayor unificado ----------

model Transaction {
  id          String          @id @default(cuid())
  date        DateTime
  amount      Decimal         @db.Decimal(16, 2)
  description String
  category    String
  type        TransactionType
  fundSource  FundSource      @default(OWN_CAPITAL)

  /// true = gasto fijo recurrente (renta, suscripciones). Alimenta el "Runway".
  isFixedExpense Boolean @default(false)

  // ----- Multimoneda -----
  // `amount` está en la moneda de la cuenta/tarjeta. Guardamos el tipo de
  // cambio del día para que los reportes históricos no cambien después.
  currency Currency @default(MXN)
  fxToMXN  Decimal  @default(1) @db.Decimal(14, 6)

  /// Persona relacionada: quién aportó el dinero (ALLOWANCE_FAMILY),
  /// quién me debe (REIMBURSABLE_EXPENSE) o con quién dividí (SHARED_SPLIT).
  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])

  /// Bolsa de dinero de un tercero (FUND_DEPOSIT / FUND_PAYMENT, o el
  /// ajuste al cerrarla con diferencia).
  fundId String?
  fund   Fund?   @relation(fields: [fundId], references: [id])

  /// Solo SHARED_SPLIT: lo que me toca a mí. El resto queda por cobrar.
  myShareAmount Decimal? @db.Decimal(16, 2)

  // Origen (EXPENSE / REIMBURSABLE / TRANSFER) o destino (INCOME).
  // Es opcional porque un gasto con tarjeta no sale de ninguna cuenta.
  accountId String?
  account   Account? @relation("TxAccount", fields: [accountId], references: [id])

  /// Solo TRANSFER entre monedas distintas: monto que llega al destino
  /// (ej. salen 100 USD, llegan 1,830 MXN). Si falta, llega `amount`.
  toAmount Decimal? @db.Decimal(16, 2)

  // Destino de un TRANSFER. Mueve saldo sin alterar el Net Worth.
  toAccountId String?
  toAccount   Account? @relation("TxToAccount", fields: [toAccountId], references: [id])

  // Tarjeta usada (gasto) o pagada (TRANSFER de cuenta → tarjeta).
  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id])

  // ----- Reembolsos -----
  reimbursementStatus ReimbursementStatus    @default(NOT_APPLICABLE)
  /// Suma de abonos recibidos, en MXN. PAID cuando cubre lo adeudado.
  amountReimbursed    Decimal                @default(0) @db.Decimal(16, 2)
  reimbursedAt        DateTime?
  /// Cuenta donde entró el dinero al marcarlo como "Cobrado".
  reimbursedToId      String?
  reimbursedTo        Account?               @relation("TxReimburseAccount", fields: [reimbursedToId], references: [id])
  payments            ReimbursementPayment[]

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([creditCardId, date])
  @@index([reimbursementStatus])
  @@index([counterpartyId])
  @@index([category, date])
}

// ---------- 3b. Personas y reembolsos parciales ----------
// Reemplaza las pestañas "Papi Debe" y "A favor papi" de la hoja.
// Saldo con cada persona = (lo que me debe por reembolsos y splits)
//                        − (abonos recibidos) − (adelantos "a favor").

model Counterparty {
  id        String   @id @default(cuid())
  name      String   @unique // Papá, Padi, Roommate…
  /// true = familia: su dinero cuenta como ALLOWANCE_FAMILY por defecto.
  isFamily  Boolean  @default(false)
  createdAt DateTime @default(now())

  transactions Transaction[]
  payments     ReimbursementPayment[]
  funds        Fund[]
}

// ---------- 3d. Bolsas: dinero de terceros que yo administro ----------
// Ej. "Colegiatura Tec · Papá". Papá deposita, yo pago. No es ingreso ni gasto.
//   balance > 0 → tengo dinero suyo sin usar (es un pasivo: no es mío)
//   balance < 0 → pagué de más: me debe la diferencia
//   balance = 0 → cuadra

model Fund {
  id             String       @id @default(cuid())
  name           String
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  /// Lo que debería costar (ej. la colegiatura). Opcional.
  expectedAmount Decimal?     @db.Decimal(16, 2)
  /// En MXN. Lo mueve solo el libro mayor.
  balance        Decimal      @default(0) @db.Decimal(16, 2)
  status         FundStatus   @default(OPEN)
  closedAt       DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions Transaction[]

  @@index([counterpartyId, status])
}

/// Un abono de alguien que me debe. Puede cubrir uno o varios gastos.
model ReimbursementPayment {
  id             String       @id @default(cuid())
  date           DateTime
  amount         Decimal      @db.Decimal(16, 2)
  /// Tipo de cambio a MXN de la cuenta que recibió el abono, ese día.
  fxToMXN        Decimal      @default(1) @db.Decimal(14, 6)
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  /// Cuenta donde entró el dinero.
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  /// Gasto específico que liquida (opcional; si falta, se aplica al más antiguo).
  transactionId  String?
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([counterpartyId, date])
}

// ---------- 3c. Categorías y presupuesto (Previsto vs Real) ----------

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id                String       @id @default(cuid())
  name              String
  kind              CategoryKind
  /// Presupuesto mensual por defecto (en MXN).
  defaultBudget     Decimal?     @db.Decimal(16, 2)
  /// Fuente de fondos sugerida al registrar (ej. "extras papi" → familia).
  defaultFundSource FundSource   @default(OWN_CAPITAL)
  isFixed           Boolean      @default(false)
  archived          Boolean      @default(false)

  budgets Budget[]

  @@unique([name, kind])
}

/// Presupuesto previsto de una categoría en un mes concreto.
model Budget {
  id            String   @id @default(cuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  month         Int
  year          Int
  plannedAmount Decimal  @db.Decimal(16, 2)

  @@unique([categoryId, year, month])
}

// ---------- 4. Metas de ahorro ----------

model SavingsGoal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Decimal   @db.Decimal(16, 2)
  currentAmount Decimal   @default(0) @db.Decimal(16, 2)
  deadline      DateTime?
  /// Cuenta que respalda la meta (opcional).
  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------- 5. Historial mensual ----------

model MonthlySnapshot {
  id               String   @id @default(cuid())
  month            Int // 1–12
  year             Int
  totalAssets      Decimal  @db.Decimal(16, 2)
  totalLiabilities Decimal  @db.Decimal(16, 2)
  netWorth         Decimal  @db.Decimal(16, 2)
  /// Porcentaje de ahorro del mes (0.25 = 25 %).
  savingsRate      Decimal  @db.Decimal(12, 6)
  totalIncome      Decimal  @default(0) @db.Decimal(16, 2)
  totalExpenses    Decimal  @default(0) @db.Decimal(16, 2)
  createdAt        DateTime @default(now())

  @@unique([year, month])
}

// ---------- Soporte: tipo de cambio ----------
// Todo se consolida en MXN. Se actualiza a mano desde Ajustes.

model ExchangeRate {
  currency  Currency @id
  /// Cuántos MXN vale 1 unidad de esta moneda.
  rateToMXN Decimal  @db.Decimal(14, 6)
  updatedAt DateTime @updatedAt
}

// ---------- Seguridad: intentos de inicio de sesión ----------
// Limita la fuerza bruta: demasiados fallos desde una IP bloquean un rato.

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
